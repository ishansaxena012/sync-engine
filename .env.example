# Copy to .env (docker-compose loads it automatically) and fill in real values.
# .env itself must never be committed — it isn't currently gitignored explicitly,
# but application*.yml already is; add ".env" to .gitignore if you create one.

DB_URL=
DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

# Only needed if you point REDIS_HOST at something other than the bundled
# docker-compose redis service (e.g. Redis Cloud) — leave blank for local.
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=

# Set to "prod" to load application-prod.yml (validate-only DDL, quieter logs).
SPRING_PROFILES_ACTIVE=
